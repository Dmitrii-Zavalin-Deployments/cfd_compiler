{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cfd_compiler_results_schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "failed"],
      "description": "Execution status of the compilation gate."
    },
    "compiled_cells_count": {
      "type": "integer",
      "description": "Total discrete cell faces compiled into the solver payload."
    },
    "boundary_conditions": {
      "type": "array",
      "description": "Fully resolved and validated boundary conditions compiled for the N-S solver.",
      "items": {
        "type": "object",
        "required": [
          "location",
          "type",
          "values"
        ],
        "properties": {
          "location": {
            "enum": [
              "x_min",
              "x_max",
              "y_min",
              "y_max",
              "z_min",
              "z_max",
              "wall"
            ]
          },
          "type": {
            "enum": [
              "no-slip",
              "free-slip",
              "inflow",
              "outflow",
              "pressure"
            ]
          },
          "values": {
            "type": "object",
            "properties": {
              "u": {
                "type": "number"
              },
              "v": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "p": {
                "type": "number"
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        }
      }
    },
    "artifacts_generated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of diagnostic QA visualization files generated during execution."
    }
  },
  "required": [
    "status",
    "compiled_cells_count",
    "boundary_conditions",
    "artifacts_generated"
  ]
}